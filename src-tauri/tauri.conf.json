{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wahana",
  "version": "0.3.0",
  "identifier": "com.ashafizullah.wahana",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Wahana",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "category": "SocialNetworking",
    "shortDescription": "Desktop client for WAHA (WhatsApp HTTP API)"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBRjc4QjNCMjE0MjA1MTMKUldRVEJVSWhPNHYzZWw0OFRTVkxsR1A5QTgyamhzM3J1ZGRmVGd5TlZudkhnY1RrQlNtN3B4aGcK",
      "endpoints": [
        "https://github.com/ashafizullah/wahana/releases/latest/download/latest.json"
      ]
    }
  }
}
