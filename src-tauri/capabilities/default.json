{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "webviews": [
    "main"
  ],
  "permissions": [
    "allow-save-api-key",
    "allow-get-api-key",
    "allow-delete-api-key",
    "allow-media-cache-has",
    "allow-media-cache-get",
    "allow-media-cache-put",
    "allow-media-cache-stats",
    "allow-media-cache-clear",
    "allow-wa-web-isolation-supported",
    "allow-wa-web-set-bounds",
    "allow-wa-web-hide",
    "allow-wa-web-remove",
    "core:default",
    "opener:default",
    "store:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        }
      ]
    },
    "core:window:allow-set-badge-count",
    "core:window:allow-set-overlay-icon",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:tray:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-file",
    "updater:default",
    "process:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
