{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "webviews": [
    "main"
  ],
  "permissions": [
    "allow-save-api-key",
    "allow-get-api-key",
    "allow-delete-api-key",
    "allow-media-cache-has",
    "allow-media-cache-get",
    "allow-media-cache-put",
    "allow-media-cache-stats",
    "allow-media-cache-clear",
    "allow-wa-native-accounts",
    "allow-wa-native-add",
    "allow-wa-native-start",
    "allow-wa-native-stop",
    "allow-wa-native-logout",
    "allow-wa-native-remove",
    "allow-wa-native-send-text",
    "allow-wa-native-react",
    "allow-wa-native-edit",
    "allow-wa-native-delete",
    "allow-wa-native-pin-message",
    "allow-wa-native-forward",
    "allow-wa-native-chats",
    "allow-wa-native-messages",
    "allow-wa-native-mark-read",
    "allow-wa-native-rename",
    "allow-wa-native-picture",
    "allow-wa-native-load-older",
    "allow-wa-native-channel-sync",
    "allow-wa-native-channel-follow",
    "allow-wa-native-channel-leave",
    "allow-wa-native-channel-mute",
    "allow-wa-native-media",
    "allow-wa-native-send-media",
    "allow-wa-native-chat-info",
    "allow-wa-native-chat-media",
    "allow-wa-native-group-action",
    "allow-wa-native-group-requests",
    "allow-wa-native-send-receipt",
    "allow-wa-native-set-typing",
    "allow-wa-native-statuses",
    "allow-wa-native-status-viewed",
    "allow-wa-native-post-status-text",
    "allow-wa-native-post-status-media",
    "allow-wa-native-delete-status",
    "allow-wa-native-labels",
    "allow-wa-native-chat-labels",
    "allow-wa-native-label-map",
    "allow-wa-native-label-create",
    "allow-wa-native-label-delete",
    "allow-wa-native-label-link",
    "allow-wa-native-pin-chat",
    "allow-wa-native-message-info",
    "allow-wa-native-mark-all-read",
    "allow-wa-native-delete-chats",
    "core:default",
    "opener:default",
    "store:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        }
      ]
    },
    "core:window:allow-set-badge-count",
    "core:window:allow-set-overlay-icon",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:tray:default",
    "dialog:default",
    "fs:default",
    "fs:allow-write-file",
    "updater:default",
    "process:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
