{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "whatsapp-web",
  "description": "WhatsApp Web child webview (remote): may only post OS notifications",
  "local": false,
  "remote": {
    "urls": ["https://web.whatsapp.com/*"]
  },
  "webviews": ["waweb-*"],
  "permissions": ["notification:allow-notify"]
}
